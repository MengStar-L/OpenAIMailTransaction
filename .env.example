# demo: no paid API calls; live: real SMSBower resources
APP_MODE=demo
LISTEN_ADDR=127.0.0.1:8080
# Separate data directories are mandatory when switching modes.
DATA_DIR=data/demo

# Administrator password is created in /admin on first use and stored as a hash in SQLite.
# Set the API key in /admin -> Settings. Saving applies immediately without a restart.
# Live resource allocation stays disabled until a key is saved.
SMSBOWER_API_BASE=https://smsbower.page

# Set true behind an HTTPS reverse proxy. False for local HTTP preview.
COOKIE_SECURE=false
# Only trust the actual reverse proxy CIDRs; leave empty for direct connections.
TRUSTED_PROXIES=

# systemd installations set systemd; leave blank for the built-in restart helper.
UPDATE_RESTART_MODE=
